<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visual Gallery HD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-neutral-950 text-neutral-100 min-h-screen font-sans selection:bg-neutral-800 selection:text-white" 
      x-data="{ filter: 'all', items: <%= JSON.stringify(items) %> }">

    <!-- Header Bersih -->
    <header class="max-w-5xl mx-auto px-6 pt-16 pb-8 text-center border-b border-neutral-900">
        <h1 class="text-3xl font-light tracking-[0.2em] uppercase text-white">Visual Gallery</h1>
        <p class="text-xs text-neutral-500 tracking-widest mt-2">High-Definition Photo & Video Vault</p>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10 space-y-12">

        <!-- Form Upload Langsung (Tanpa Pop-up) -->
        <div class="bg-neutral-900/50 border border-neutral-800/80 rounded-3xl p-6 md:p-8 backdrop-blur-xl">
            <h2 class="text-xs uppercase tracking-widest text-neutral-400 font-medium mb-4">Unggah File Baru</h2>
            
            <% if (error) { %>
                <div class="mb-4 p-3 bg-red-950/50 border border-red-900 text-red-400 text-xs rounded-xl">
                    <%= error %>
                </div>
            <% } %>

            <form action="/upload" method="POST" enctype="multipart/form-data" class="flex flex-col md:flex-row items-center gap-4">
                <input type="file" name="media" required 
                       class="w-full text-xs text-neutral-400 file:mr-4 file:py-3 file:px-6 file:rounded-full file:border-0 file:text-xs file:font-medium file:bg-neutral-800 file:text-neutral-200 hover:file:bg-neutral-700 cursor-pointer bg-neutral-950 rounded-full border border-neutral-800">
                <button type="submit" 
                        class="w-full md:w-auto px-8 py-3 bg-white text-black text-xs font-medium uppercase tracking-widest rounded-full hover:bg-neutral-200 transition whitespace-nowrap shadow-lg">
                    Kirim Media
                </button>
            </form>
        </div>

        <!-- Filter Kategori -->
        <div class="flex items-center justify-center gap-3">
            <button @click="filter = 'all'" :class="filter === 'all' ? 'bg-white text-black' : 'bg-neutral-900 text-neutral-400 hover:text-white'" class="px-5 py-2 rounded-full text-xs tracking-wider transition">Semua</button>
            <button @click="filter = 'photo'" :class="filter === 'photo' ? 'bg-white text-black' : 'bg-neutral-900 text-neutral-400 hover:text-white'" class="px-5 py-2 rounded-full text-xs tracking-wider transition">Foto</button>
            <button @click="filter = 'video'" :class="filter === 'video' ? 'bg-white text-black' : 'bg-neutral-900 text-neutral-400 hover:text-white'" class="px-5 py-2 rounded-full text-xs tracking-wider transition">Video</button>
        </div>

        <!-- Galeri Media -->
        <div>
            <% if (items.length === 0) { %>
                <div class="text-center py-24 text-neutral-600 font-light text-sm tracking-wider">
                    Belum ada file media yang diunggah.
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <template x-for="(item, index) in items" :key="index">
                        <div x-show="filter === 'all' || (filter === 'video' && item.isVideo) || (filter === 'photo' && !item.isVideo)"
                             class="bg-neutral-900/40 border border-neutral-800 rounded-3xl overflow-hidden shadow-2xl flex flex-col">
                            
                            <!-- Tampilan Media -->
                            <div class="aspect-video bg-neutral-950 overflow-hidden relative">
                                <template x-if="item.isVideo">
                                    <video controls class="w-full h-full object-cover">
                                        <source :src="item.url" type="video/mp4">
                                    </video>
                                </template>
                                <template x-if="!item.isVideo">
                                    <img :src="item.url" class="w-full h-full object-cover">
                                </template>
                            </div>

                            <!-- Panel Tombol Aksi Bawah (Menarik, Rapi & Fungsional) -->
                            <div class="p-5 flex flex-wrap items-center justify-between gap-4 bg-neutral-900/80 border-t border-neutral-800">
                                <span class="text-[10px] uppercase tracking-widest text-neutral-500 font-mono" x-text="item.isVideo ? 'Format: Video' : 'Format: Foto HD'"></span>
                                
                                <div class="flex items-center gap-3">
                                    <!-- Tombol Salin Link -->
                                    <button @click="navigator.clipboard.writeText(window.location.origin + item.url); alert('Tautan berhasil disalin ke clipboard!');" 
                                            class="px-3.5 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 text-[11px] font-medium tracking-wider rounded-full transition">
                                        Salin Link
                                    </button>

                                    <!-- Tombol Unduh HD -->
                                    <a :href="item.url" target="_blank" 
                                       class="px-3.5 py-1.5 bg-white hover:bg-neutral-200 text-black text-[11px] font-medium tracking-wider rounded-full transition">
                                        Unduh HD
                                    </a>

                                    <!-- Tombol Hapus -->
                                    <form :action="'/delete/' + item.name" method="POST" onsubmit="return confirm('Yakin ingin menghapus permanen file ini?');" class="inline">
                                        <button type="submit" 
                                                class="px-3.5 py-1.5 bg-red-950/60 hover:bg-red-900 text-red-400 text-[11px] font-medium tracking-wider rounded-full transition border border-red-900/50">
                                            Hapus
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </template>
                </div>
            <% } %>
        </div>

    </main>
</body>
</html>
