<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curated Gallery & Media Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-black text-white min-h-screen font-sans selection:bg-neutral-800 selection:text-white" 
      x-data="{ filter: 'all', activeIndex: null, items: <%= JSON.stringify(items) %> }">

    <!-- Header & Navigation -->
    <header class="max-w-7xl mx-auto px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-6 border-b border-neutral-900">
        <div>
            <h1 class="text-2xl font-light tracking-widest uppercase">Visual Gallery</h1>
            <p class="text-xs text-neutral-500 tracking-wider mt-1">High-Definition Portfolio & Memory Archive</p>
        </div>

        <!-- Tombol Trigger Upload Modal -->
        <div x-data="{ openUpload: false }">
            <button @click="openUpload = true" class="px-6 py-2.5 bg-white text-black text-xs font-medium uppercase tracking-widest rounded-full hover:bg-neutral-200 transition">
                + Upload New
            </button>

            <!-- Modal Form Upload -->
            <div x-show="openUpload" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4" style="display: none;" @click.self="openUpload = false">
                <div class="bg-neutral-950 border border-neutral-800 p-8 rounded-3xl max-w-md w-full relative shadow-2xl">
                    <button @click="openUpload = false" class="absolute top-6 right-6 text-neutral-400 hover:text-white text-sm">✕</button>
                    <h2 class="text-lg font-light tracking-wide mb-2">Tambah Media Baru</h2>
                    <p class="text-xs text-neutral-500 mb-6">Pilih foto, live photo, atau video (maks. 100MB).</p>
                    
                    <% if (error) { %>
                        <div class="mb-4 p-3 bg-red-950/40 border border-red-900/50 text-red-400 text-xs rounded-xl">
                            <%= error %>
                        </div>
                    <% } %>

                    <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <input type="file" name="media" required class="w-full text-xs text-neutral-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-neutral-800 file:text-neutral-200 hover:file:bg-neutral-700 cursor-pointer">
                        <button type="submit" class="w-full py-3 bg-white text-black text-xs font-semibold uppercase tracking-widest rounded-full hover:bg-neutral-200 transition">
                            Proses Unggah
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- Filter Kategori Galeri -->
    <div class="max-w-7xl mx-auto px-6 py-8 flex items-center justify-center gap-4">
        <button @click="filter = 'all'" :class="filter === 'all' ? 'bg-white text-black' : 'bg-neutral-900 text-neutral-400 hover:text-white'" class="px-5 py-2 rounded-full text-xs font-medium tracking-wider transition">Semua</button>
        <button @click="filter = 'photo'" :class="filter === 'photo' ? 'bg-white text-black' : 'bg-neutral-900 text-neutral-400 hover:text-white'" class="px-5 py-2 rounded-full text-xs font-medium tracking-wider transition">Foto</button>
        <button @click="filter = 'video'" :class="filter === 'video' ? 'bg-white text-black' : 'bg-neutral-900 text-neutral-400 hover:text-white'" class="px-5 py-2 rounded-full text-xs font-medium tracking-wider transition">Video</button>
    </div>

    <!-- Grid Galeri Artistik -->
    <main class="max-w-7xl mx-auto px-6 pb-24">
        <% if (items.length === 0) { %>
            <div class="text-center py-32 text-neutral-600 font-light tracking-wide">
                Galeri masih kosong. Silakan unggah karya media Anda.
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                <template x-for="(item, index) in items" :key="index">
                    <div x-show="filter === 'all' || (filter === 'video' && item.isVideo) || (filter === 'photo' && !item.isVideo)"
                         class="group relative aspect-[4/5] bg-neutral-900 overflow-hidden rounded-2xl cursor-pointer shadow-lg"
                         @click="activeIndex = index">
                        
                        <!-- Konten Media -->
                        <template x-if="item.isVideo">
                            <video class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition duration-700">
                                <source :src="item.url" type="video/mp4">
                            </video>
                        </template>
                        <template x-if="!item.isVideo">
                            <img :src="item.url" class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition duration-700">
                        </template>

                        <!-- Overlay Info saat Hover -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex flex-col justify-end p-6">
                            <span class="text-[10px] tracking-widest text-neutral-400 uppercase font-light" x-text="item.isVideo ? 'Video HD' : 'Foto HD'"></span>
                            <div class="flex items-center justify-between mt-2">
                                <span class="text-xs font-medium tracking-wider text-white">Lihat Detail</span>
                                <span class="text-xs text-neutral-400">↗</span>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        <% } %>
    </main>

    <!-- Fullscreen Immersive Lightbox Modal -->
    <div x-show="activeIndex !== null" class="fixed inset-0 bg-black/95 backdrop-blur-2xl z-50 flex items-center justify-center p-4 md:p-12" style="display: none;" @keydown.escape.window="activeIndex = null">
        
        <!-- Tombol Tutup -->
        <button @click="activeIndex = null" class="absolute top-6 right-6 text-neutral-400 hover:text-white text-xl z-50 w-12 h-12 flex items-center justify-center rounded-full bg-neutral-900/50">✕</button>

        <template x-if="activeIndex !== null && items[activeIndex]">
            <div class="max-w-5xl w-full h-full flex flex-col items-center justify-center relative">
                
                <!-- Tampilan Media di Lightbox -->
                <div class="flex-1 flex items-center justify-center w-full overflow-hidden">
                    <template x-if="items[activeIndex].isVideo">
                        <video controls autoplay class="max-h-[75vh] max-w-full rounded-xl shadow-2xl">
                            <source :src="items[activeIndex].url" type="video/mp4">
                        </video>
                    </template>
                    <template x-if="!items[activeIndex].isVideo">
                        <img :src="items[activeIndex].url" class="max-h-[75vh] max-w-full object-contain rounded-xl shadow-2xl">
                    </template>
                </div>

                <!-- Panel Bawah Lightbox (Tombol Aksi: Download & Hapus) -->
                <div class="w-full py-6 flex items-center justify-between border-t border-neutral-900 mt-4">
                    <div class="flex items-center gap-6">
                        <a :href="items[activeIndex].url" target="_blank" class="text-xs font-light tracking-widest text-neutral-300 hover:text-white uppercase underline">Unduh File Asli (HD)</a>
                        <button @click="navigator.clipboard.writeText(window.location.origin + items[activeIndex].url); alert('Tautan berhasil disalin!');" class="text-xs font-light tracking-widest text-neutral-400 hover:text-white uppercase">Salin Tautan</button>
                    </div>

                    <form :action="'/delete/' + items[activeIndex].name" method="POST" onsubmit="return confirm('Hapus permanen karya ini dari galeri?');">
                        <button type="submit" class="text-xs font-light tracking-widest text-red-400 hover:text-red-300 uppercase">Hapus Media</button>
                    </form>
                </div>

            </div>
        </template>
    </div>

</body>
</html>
